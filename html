<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trợ Lý Soạn Kế Hoạch Bài Dạy - Chuẩn GDPT 2018</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; }
    .prose table { width: 100%; border-collapse: collapse; margin-top: 1rem; margin-bottom: 1rem; }
    .prose th, .prose td { border: 1px solid #cbd5e1; padding: 10px 12px; text-align: left; }
    .prose th { background-color: #f1f5f9; font-weight: 600; }
    .prose h1, .prose h2, .prose h3 { font-weight: 700; color: #1e293b; margin-top: 1.25rem; margin-bottom: 0.5rem; }
    .prose h1 { font-size: 1.5rem; text-align: center; }
    .prose h2 { font-size: 1.25rem; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.25rem; }
    .prose h3 { font-size: 1.1rem; }
    .prose ul { list-style-type: disc; padding-left: 1.5rem; margin-top: 0.5rem; margin-bottom: 0.5rem; }
  </style>
</head>
<body class="bg-slate-50 min-h-screen text-slate-800">

  <!-- Header -->
  <header class="bg-gradient-to-r from-teal-600 to-emerald-700 text-white py-6 shadow-md">
    <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="p-3 bg-white/10 rounded-xl">
          <i class="fa-solid fa-book-open-reader text-3xl"></i>
        </div>
        <div>
          <h1 class="text-2xl font-bold">Trợ Lý Soạn Giáo Án Tiểu Học</h1>
          <p class="text-sm text-teal-100">Chuẩn Công văn 2345/BGDĐT & Chương trình GDPT 2018</p>
        </div>
      </div>
      <div class="w-full md:w-auto">
        <input id="apiKeyInput" type="password" placeholder="Dán Gemini API Key tại đây..." 
               class="w-full md:w-80 px-3 py-2 text-sm bg-teal-800/60 border border-teal-400/40 rounded-lg text-white placeholder-teal-200 outline-none focus:ring-2 focus:ring-white">
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Sidebar: Form nhập liệu -->
    <div class="lg:col-span-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col gap-5 h-fit">
      <h2 class="text-lg font-bold text-slate-800 border-b pb-2 flex items-center gap-2">
        <i class="fa-solid fa-sliders text-teal-600"></i> Thiết lập bài dạy
      </h2>

      <!-- Khối lớp -->
      <div>
        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Khối lớp</label>
        <select id="gradeSelect" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500 outline-none text-sm">
          <option value="Lớp 5" selected>Lớp 5</option>
          <option value="Lớp 4">Lớp 4</option>
          <option value="Lớp 3">Lớp 3</option>
          <option value="Lớp 2">Lớp 2</option>
          <option value="Lớp 1">Lớp 1</option>
        </select>
      </div>

      <!-- Môn học -->
      <div>
        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Môn học</label>
        <select id="subjectSelect" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500 outline-none text-sm">
          <option value="Tiếng Việt">Tiếng Việt</option>
          <option value="Toán">Toán</option>
          <option value="Hoạt động trải nghiệm">Hoạt động trải nghiệm</option>
          <option value="Đạo đức">Đạo đức</option>
          <option value="Khoa học">Khoa học</option>
          <option value="Lịch sử và Địa lí">Lịch sử và Địa lí</option>
          <option value="Công nghệ">Công nghệ</option>
          <option value="Tin học">Tin học</option>
        </select>
      </div>

      <!-- Bộ sách -->
      <div>
        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Bộ sách</label>
        <select id="bookSelect" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500 outline-none text-sm">
          <option value="Kết nối tri thức với cuộc sống">Kết nối tri thức với cuộc sống</option>
          <option value="Cánh Diều">Cánh Diều</option>
          <option value="Chân trời sáng tạo">Chân trời sáng tạo</option>
        </select>
      </div>

      <!-- Tên bài học -->
      <div>
        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Tên bài học</label>
        <input id="lessonName" type="text" placeholder="Ví dụ: Ôn tập về phân số (Tiết 1)..." 
               class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500 outline-none text-sm">
      </div>

      <!-- Thời lượng -->
      <div>
        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Thời lượng</label>
        <input id="lessonDuration" type="text" value="1 tiết (35 phút)" 
               class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500 outline-none text-sm">
      </div>

      <!-- Tùy chọn mở rộng -->
      <div class="space-y-2 border-t pt-3">
        <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
          <input type="checkbox" id="optGame" checked class="rounded text-teal-600 focus:ring-teal-500">
          <span>Gợi ý trò chơi khởi động sôi nổi</span>
        </label>
        <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
          <input type="checkbox" id="optDifferentiate" checked class="rounded text-teal-600 focus:ring-teal-500">
          <span>Phân hóa hỗ trợ học sinh & câu hỏi nâng cao</span>
        </label>
      </div>

      <!-- Nút tạo -->
      <button id="btnGenerate" onclick="generateLessonPlan()" 
              class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 rounded-xl shadow transition flex items-center justify-center gap-2">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        <span>Tạo Kế Hoạch Bài Dạy</span>
      </button>
    </div>

    <!-- Output Container -->
    <div class="lg:col-span-8 flex flex-col gap-4">
      <!-- Toolbar thao tác -->
      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-wrap items-center justify-between gap-3">
        <span class="text-sm font-semibold text-slate-600 flex items-center gap-2">
          <i class="fa-regular fa-file-lines text-teal-600"></i> Nội dung giáo án
        </span>
        <div class="flex items-center gap-2">
          <button onclick="copyContent()" class="px-3 py-1.5 text-xs font-medium bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg flex items-center gap-1.5 transition">
            <i class="fa-regular fa-copy"></i> Sao chép
          </button>
          <button onclick="exportToWord()" class="px-3 py-1.5 text-xs font-medium bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-lg flex items-center gap-1.5 transition">
            <i class="fa-regular fa-file-word"></i> Xuất file Word (.doc)
          </button>
          <button onclick="window.print()" class="px-3 py-1.5 text-xs font-medium bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg flex items-center gap-1.5 transition">
            <i class="fa-solid fa-print"></i> In / Lưu PDF
          </button>
        </div>
      </div>

      <!-- Preview Sheet -->
      <div id="resultBox" class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 min-h-[500px] prose max-w-none text-slate-700">
        <div class="text-center text-slate-400 py-20 flex flex-col items-center justify-center gap-3">
          <i class="fa-solid fa-pen-ruler text-4xl text-slate-300"></i>
          <p>Nhập thông tin bài dạy ở cột bên trái và bấm <strong>"Tạo Kế Hoạch Bài Dạy"</strong> để bắt đầu.</p>
        </div>
      </div>
    </div>

  </main>

  <script>
    // Tự động lưu và tải API Key vào LocalStorage
    document.addEventListener("DOMContentLoaded", () => {
      const savedKey = localStorage.getItem("gemini_api_key");
      if (savedKey) document.getElementById("apiKeyInput").value = savedKey;
      document.getElementById("apiKeyInput").addEventListener("change", (e) => {
        localStorage.setItem("gemini_api_key", e.target.value.trim());
      });
    });

    async function generateLessonPlan() {
      const apiKey = document.getElementById("apiKeyInput").value.trim();
      const grade = document.getElementById("gradeSelect").value;
      const subject = document.getElementById("subjectSelect").value;
      const book = document.getElementById("bookSelect").value;
      const lessonName = document.getElementById("lessonName").value.trim();
      const duration = document.getElementById("lessonDuration").value.trim();
      const optGame = document.getElementById("optGame").checked;
      const optDifferentiate = document.getElementById("optDifferentiate").checked;

      if (!apiKey) {
        alert("Thầy vui lòng nhập Gemini API Key ở góc trên bên phải.");
        return;
      }
      if (!lessonName) {
        alert("Thầy vui lòng nhập Tên bài học.");
        return;
      }

      const btn = document.getElementById("btnGenerate");
      const resultBox = document.getElementById("resultBox");

      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Đang soạn giáo án...</span>';
      resultBox.innerHTML = '<div class="text-center py-20 text-slate-500 flex flex-col items-center gap-3"><i class="fa-solid fa-circle-notch fa-spin text-3xl text-teal-600"></i><p>Trợ lý đang thiết kế kế hoạch bài dạy chuẩn Công văn 2345...</p></div>';

      const prompt = `
Bạn là chuyên gia giáo dục tiểu học Việt Nam, nắm vững chương trình GDPT 2018 và cấu trúc Kế hoạch bài dạy theo đúng Công văn 2345/BGDĐT.
Hãy soạn Kế hoạch bài dạy chi tiết cho bài học sau:
- Khối lớp: ${grade}
- Môn học: ${subject}
- Bộ sách: ${book}
- Tên bài dạy: ${lessonName}
- Thời lượng: ${duration}
- Yêu cầu thêm: ${optGame ? "Tích hợp trò chơi khởi động hấp dẫn." : ""} ${optDifferentiate ? "Chú trọng phân hóa đối tượng và câu hỏi hỗ trợ học sinh." : ""}

CẤU TRÚC KẾ HOẠCH BÀI DẠY BẮT BUỘC:
# KẾ HOẠCH BÀI DẠY: ${lessonName.toUpperCase()}
**Môn:** ${subject} - **${grade}** (${book})  
**Thời lượng:** ${duration}

## I. YÊU CẦU CẦN ĐẠT
1. **Năng lực đặc thù:** (Nêu rõ các biểu hiện cụ thể học sinh đạt được sau bài học)
2. **Năng lực chung:** (Tự chủ - tự học, Giao tiếp - hợp tác, Giải quyết vấn đề - sáng tạo)
3. **Phẩm chất:** (Yêu nước, Nhân ái, Chăm chỉ, Trung thực, Trách nhiệm)

## II. ĐỒ DÙNG DẠY HỌC
1. **Giáo viên:** (Thiết bị, bài giảng điện tử, phiếu học tập...)
2. **Học sinh:** (Sách giáo khoa, vở ghi, đồ dùng học tập...)

## III. CÁC HOẠT ĐỘNG DẠY HỌC CHỦ YẾU
Hãy trình bày chi tiết cả 4 hoạt động dưới dạng BẢNG 2 CỘT chuẩn Markdown:
- Cột 1: **Hoạt động của giáo viên**
- Cột 2: **Hoạt động của học sinh**

Bao gồm đủ 4 hoạt động:
1. **Hoạt động 1: Khởi động** (Tạo tâm thế, trò chơi/kết nối bài cũ)
2. **Hoạt động 2: Khám phá / Hình thành kiến thức mới**
3. **Hoạt động 3: Luyện tập, thực hành**
4. **Hoạt động 4: Vận dụng, trải nghiệm**

## IV. ĐIỀU CHỈNH SAU BÀI DẠY (Để trống dòng kẻ cho GV ghi chép)
`;

      try {
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            contents: [{ parts: [{ text: prompt }] }]
          })
        });

        const data = await response.json();
        if (data.candidates && data.candidates[0].content.parts[0].text) {
          const markdownText = data.candidates[0].content.parts[0].text;
          resultBox.innerHTML = marked.parse(markdownText);
        } else {
          resultBox.innerHTML = '<div class="text-red-500 py-10 text-center">Không tạo được nội dung. Vui lòng kiểm tra lại API Key.</div>';
        }
      } catch (err) {
        resultBox.innerHTML = `<div class="text-red-500 py-10 text-center">Đã xảy ra lỗi kết nối: ${err.message}</div>`;
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles"></i> <span>Tạo Kế Hoạch Bài Dạy</span>';
      }
    }

    function copyContent() {
      const resultBox = document.getElementById("resultBox");
      navigator.clipboard.writeText(resultBox.innerText).then(() => {
        alert("Đã sao chép toàn bộ nội dung giáo án vào bộ nhớ tạm!");
      });
    }

    function exportToWord() {
      const content = document.getElementById("resultBox").innerHTML;
      const header = "<html xmlns:o='urn:schemas-microsoft-com:office:office' "+
            "xmlns:w='urn:schemas-microsoft-com:office:word' "+
            "xmlns='http://www.w3.org/TR/REC-html40'>"+
            "<head><meta charset='utf-8'><title>Kế hoạch bài dạy</title><style>table{border-collapse:collapse;width:100%;}td,th{border:1px solid #000;padding:6px;}body{font-family:'Times New Roman',serif;font-size:13pt;line-height:1.3;}</style></head><body>";
      const footer = "</body></html>";
      const sourceHTML = header + content + footer;
      
      const source = 'data:application/vnd.ms-word;charset=utf-8,' + encodeURIComponent(sourceHTML);
      const fileDownload = document.createElement("a");
      document.body.appendChild(fileDownload);
      fileDownload.href = source;
      fileDownload.download = 'Ke_hoach_bai_day.doc';
      fileDownload.click();
      document.body.removeChild(fileDownload);
    }
  </script>
</body>
</html>
